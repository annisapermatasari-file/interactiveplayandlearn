# Copy this file to .env and fill in real values.
# Never commit .env or any file containing real secrets.

# PostgreSQL connection string (Neon in production, e.g.
# postgresql://user:password@ep-example.neon.tech/counting_lms?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/counting_lms"

# Auth.js (NextAuth) configuration — added in Phase 2 (Authentication).
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
